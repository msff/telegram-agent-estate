#!/bin/zsh
# telegram-agent-estate — the one command this plugin puts on your PATH.
#
# Usage:  telegram-agent-estate <subcommand> [args...]
#
# ------------------------------------------------------------------------------
# WHY THIS FILE EXISTS (KTD5)
#
# Claude Code adds an enabled plugin's `bin/` to the Bash tool's PATH for every
# session — verified live. So whatever sits in `bin/` is what an installing
# stranger's shell resolves `send.py`, `guard.py`, `parity.sh` and
# `supervisor.sh` to. Twelve generic names is a collision surface; one
# namespaced name is a reasonable thing to ask of a user.
#
# Therefore: the implementation lives in `libexec/`, which is on nobody's PATH,
# and this dispatcher is the only inhabitant of `bin/`. launchd still invokes
# `libexec/supervisor.sh` and `libexec/run-job.sh` by absolute path — the plists
# do not route through here, because a scheduled job must not depend on PATH at
# all.
#
# THE EXIT CODE IS THE CONTRACT. Every subcommand `exec`s its target, so the
# status a caller sees is the target's own, unmodified, by construction rather
# than by a `$?` that someone might one day forget to propagate. That matters
# beyond tidiness: `run-job.sh` carries the guard's idempotency codes
# (0 enqueued · 3 marker · 4 lease · 5 too early) and losing one of them turns
# duplicate suppression into a duplicate send.
#
# This script's OWN failures use 2, the same code the libexec entry points use
# for "you asked for something I cannot do": unknown subcommand, missing
# subcommand, and a subcommand whose implementation has not landed yet.
# ------------------------------------------------------------------------------
set -u

SELF="${0:A}"
BIN_DIR="${SELF:h}"
PLUGIN_ROOT="${BIN_DIR:h}"

# WHICH `libexec/` (KTD1). The rule and the reasoning live in
# `libexec/estate-runtime.zsh`, in one copy, because the installer has to apply
# exactly the same rule when it stamps a path into a plist. In one line: an
# override wins; a cache-resident dispatcher runs the provisioned runtime or
# refuses; anything else runs the code next to it.
#
# Sourced from THIS tree, deliberately. It is 150 lines that compute a path and
# execute nothing, and there is no way to learn where the runtime is without
# reading something first — the same bootstrap the dispatcher itself is.
if ! source "$PLUGIN_ROOT/libexec/estate-runtime.zsh" 2>/dev/null; then
  print -ru2 -- "telegram-agent-estate: missing $PLUGIN_ROOT/libexec/estate-runtime.zsh"
  print -ru2 -- "  This copy of the plugin is incomplete. Reinstall it."
  exit 2
fi

usage() {
  cat <<'EOF'
usage: telegram-agent-estate <subcommand> [args...]

  provision [--source <url|path>] [--ref <tag|branch|sha>] [--status]
        clone the pinned checkout that launchd will execute
  upgrade [--source <url|path>] [--ref <tag|branch|sha>] [--no-restart]
        move that checkout to a new pin, verify it, restart the supervisors
  install <instance.yaml> [--dry-run] [--no-load]
        render this instance's launchd plists and load them
  parity <instance.yaml> [--real]
        run the parity suite against this instance

Not yet available:
  uninstall             (lands with the setup skill)

`install` and `parity` run the PROVISIONED runtime — the same code the daemons
execute — not necessarily the copy this command was resolved from. `provision`
and `upgrade` are the exception: they run from this tree, because they are what
creates the runtime in the first place.

Arguments and exit codes are passed through to the implementation in
libexec/ unchanged.
EOF
}

# subcommand -> the libexec entry point it is a name for.
typeset -A TARGETS=(
  install   install-instance.sh
  parity    parity.sh
  provision provision-runtime.sh
  upgrade   provision-runtime.sh
)

# The two verbs that share one entry point, which therefore has to be told which
# name it was invoked as. The verb is prepended to argv rather than inferred
# from `$0`, so a symlink or a rename cannot change what it does.
typeset -A VERB_OF=(
  provision provision
  upgrade   upgrade
)

# Bootstrap verbs. These must NOT resolve through the stamp: they are what
# writes it, so requiring one would make provisioning impossible on the machine
# that has never provisioned.
typeset -A SELF_RESOLVED=(
  provision 1
  upgrade   1
)

# subcommand -> why it is not runnable yet. Declared rather than omitted so the
# five-name surface is visible in `--help` from the start, and so asking for one
# early gets an answer instead of "unknown subcommand", which reads as a typo.
typeset -A PENDING=(
  uninstall "uninstall-instance.sh lands with the setup skill"
)

cmd="${1:-}"
case "$cmd" in
  ""|-h|--help|help)
    usage
    [[ -z "$cmd" ]] && exit 2
    exit 0
    ;;
esac
shift

if [[ -n "${PENDING[$cmd]:-}" ]]; then
  print -ru2 -- "telegram-agent-estate: '$cmd' is not available yet — ${PENDING[$cmd]}."
  exit 2
fi

target="${TARGETS[$cmd]:-}"
if [[ -z "$target" ]]; then
  print -ru2 -- "telegram-agent-estate: unknown subcommand '$cmd'"
  usage >&2
  exit 2
fi

if [[ -n "${SELF_RESOLVED[$cmd]:-}" ]]; then
  LIBEXEC="$PLUGIN_ROOT/libexec"
else
  estate_resolve_libexec "$PLUGIN_ROOT" || exit $?
  LIBEXEC="$ESTATE_LIBEXEC_DIR"
fi

if [[ ! -x "$LIBEXEC/$target" ]]; then
  print -ru2 -- "telegram-agent-estate: missing or non-executable $LIBEXEC/$target"
  print -ru2 -- "  This copy of the plugin is incomplete. Reinstall it."
  exit 2
fi

verb="${VERB_OF[$cmd]:-}"
if [[ -n "$verb" ]]; then
  exec "$LIBEXEC/$target" "$verb" "$@"
fi
exec "$LIBEXEC/$target" "$@"
